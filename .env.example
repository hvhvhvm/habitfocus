# ============================================================
# FRONTEND (Vite / React) — set these in Vercel Dashboard
# ============================================================

# Your Supabase project URL and anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Your Render FastAPI backend URL (REQUIRED for Vercel deployment)
# Without this, the frontend won't be able to reach the backend.
VITE_BACKEND_URL=https://your-fastapi-app.onrender.com

# Optional: pre-created demo Supabase user for the "Demo" button
VITE_DEMO_EMAIL=demo@yourdomain.com
VITE_DEMO_PASSWORD=your-demo-password

# ============================================================
# BACKEND (FastAPI on Render) — set these in Render Dashboard
# ============================================================

# Your Supabase project URL and anon key (for token verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase PostgreSQL connection string (from Supabase → Settings → Database)
DATABASE_URL=postgresql://postgres.xxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
